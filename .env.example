# 复制为 .env 后填写(.env 已被 .gitignore 忽略,不要提交真实值)
# 可选：部署时指定已经构建好的前端镜像，与后端 IOEDU_IMAGE 等变量配合使用
# IOEDU_FRONTEND_IMAGE=ioedu-frontend:latest

# MySQL root 密码(同时用于后端连接)
DB_PASSWORD=change-me-db-password
# 后端连接池大小,单实例服务 100 个客户可保持 20~30
DB_POOL_SIZE=20

# JWT 签名密钥:必填,不少于 32 个随机字符。生成示例:openssl rand -base64 48
JWT_SECRET=

# 首次启动创建的管理员;密码留空则随机生成并打印到后端日志(docker compose logs backend | grep 初始密码)
ADMIN_EMAIL=admin@ioedu.cn
ADMIN_PASSWORD=
# 是否写入演示数据(演示师生账号密码均为 123456),生产必须为 false
SEED_DEMO=false

# ---- 多租户(一套后端服务多个客户,每个客户一个独立数据库) ----
# 子域名根域:配好泛域名解析 *.根域 → 本机后,c001.根域 访问的就是租户 c001;根域/www 为默认租户。留空则单租户模式
TENANT_BASE_DOMAIN=
# true:无法匹配租户的 Host 一律 404;false:落到默认租户(单租户或用 IP 访问时保持 false)
TENANT_STRICT_HOST=false
# 平台管理接口(开通/停用租户)的静态令牌,不少于 16 位随机字符;留空则关闭平台接口。生成:openssl rand -hex 24
PLATFORM_TOKEN=
# 平台库名(存租户注册表),一般不用改
PLATFORM_DB=ioedu_platform

# ---- 项目商店(hub,所有客户共用的公共中心服务) ----
# 平台管理员登录令牌密钥,不少于 32 个随机字符(与 JWT_SECRET 不同)。生成:openssl rand -base64 48
HUB_JWT_SECRET=
# 平台管理员账号;密码留空则随机生成并打印到 docker compose logs hub
HUB_ADMIN_USERNAME=platform
HUB_ADMIN_PASSWORD=
# 后端调用商店的内网地址,一般不用改
HUB_BASE_URL=http://hub:8081
# 商店后台展示客户站点地址用的模板,{code} 会替换为站点编码。暂不配 HTTPS 时用 http://{code}.根域:8093
SITE_URL_TEMPLATE=
# 库内密钥类配置(商店 API Key、大模型 API Key)的加密主密钥,不少于 32 个随机字符;换了会导致已保存的密钥无法解密
MASTER_KEY=

# ================= KiCad AI 设计助手(kicad-ai 服务,可选覆盖) =================
# 不填则沿用上面的 AI_API_KEY / AI_MODEL(DeepSeek);LLM_PROVIDER 固定为 OpenAI 兼容(custom)
# KICAD_LLM_BASE_URL=https://api.deepseek.com
# KICAD_LLM_API_KEY=
# KICAD_LLM_MODEL=deepseek-chat
# KICAD_MEMORY=3072M
# 构建镜像源(国内服务器建议保留默认:阿里云 PyPI / npmmirror / 阿里云 Debian 源)
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com/
# APT_MIRROR=mirrors.aliyun.com

# 微信小程序(不用小程序可留空;泄露过的密钥请在微信公众平台重置)
WECHAT_APPID=
WECHAT_SECRET=

# AI 大模型(可留空,之后在管理后台「AI 设置」在线配置;后台保存的 Key 用 MASTER_KEY 加密)
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
# AI 助手每人每日运行次数上限(0 不限)
AI_DAILY_RUNS=50

# ---- 文件存储（主系统 + 项目商店共用，按商户 / hub 隔离） ----
# 配齐后改为 oss；旧文件仍可读取，迁移见 docs/OSS存储升级说明.md
STORAGE_TYPE=local
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=
OSS_PREFIX=ioedu
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
# 可选：已绑定 OSS、配置 HTTPS 的自定义域名。空时经后端流式预览（不落盘）。
OSS_PUBLIC_DOMAIN=
OSS_SIGNED_URL_SECONDS=3600

# 浏览器/小程序直传：配置 OSS 跨域和 staging/ 生命周期后开启
OSS_DIRECT_UPLOAD=false
# 公网地域 Endpoint；留空按 OSS_REGION 生成，不能填内网 Endpoint 或 CDN 域名
OSS_UPLOAD_ENDPOINT=
OSS_UPLOAD_SECONDS=900
# 独立的 CDN 加速域名，源站为私有 OSS，启用 A类鉴权；有效期需与控制台一致
CDN_DOMAIN=
CDN_AUTH_KEY=
CDN_AUTH_SECONDS=7200
# 云端 HLS 按需转码：先开通 IMM、绑定 Bucket、配置 CDN ts 回源处理，详见升级说明
VIDEO_HLS=false
