# ================= LLM =================
# openai | anthropic | custom (OpenAI-compatible: DeepSeek / Qwen / Moonshot / Ollama ...) | mock (offline demo)
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6
LLM_API_KEY=sk-...
# Only for custom / OpenAI-compatible endpoints, e.g. https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_CONTEXT_TOKENS=128000
# default | off | fast | deep. Users can override this per chat request.
LLM_THINKING=off
# Reasoning-token cap used by "fast" when the endpoint has no effort levels.
LLM_THINKING_BUDGET=4096
# auto | bailian | thinking_type | chat_template_kwargs | ollama | none
LLM_THINKING_STYLE=auto

# ================= Server ==============
HOST=0.0.0.0
PORT=8000
DEBUG=false
# JSON list of allowed browser origins (dev server default)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ================= Auth ================
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
ALLOW_REGISTRATION=true

# ================= Storage =============
# Default: SQLite files under backend/data (app.db, checkpoints.sqlite, store.sqlite)
# For production use PostgreSQL for everything (needs requirements-postgres.txt):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/kicad_ai
DATABASE_URL=
# Per-user workspaces (uploaded KiCad projects); default backend/data/workspaces
WORKSPACE_ROOT=

# ================= Agent ===============
ENABLE_SUBAGENTS=true
# LangGraph steps per request; one model→tools round costs ~4 steps (400 ≈ 100 rounds)
AGENT_RECURSION_LIMIT=400
# Wall-clock ceiling for one chat turn in seconds (0 = unlimited). Runs execute in the
# background, so a timed-out run is reported like the step limit and can be continued.
AGENT_RUN_TIMEOUT_SECONDS=1800
# Total tokens (all model calls of one turn) before the run is paused (0 = unlimited)
AGENT_RUN_TOKEN_BUDGET=3000000
# Tool results above this many characters are shrunk (largest list cut, full payload
# spilled to the user's workspace under .agent/tool_results) before reaching the model
TOOL_RESULT_MAX_CHARS=24000
# mock provider only: artificial latency per model call (ms) for realistic demos
LLM_MOCK_DELAY_MS=0

# ================= Upstream kcaa MCP server (optional) =================
# Run `pip install kcaa` then `MCP_TRANSPORT=streamable-http MCP_PORT=8765 kcaa`
# and point the URL here to add all upstream KiCad tools (symbol/footprint search, routing, IPC ...)
KCAA_MCP_URL=
KCAA_MCP_TRANSPORT=http

# ================= KiCad ===============
# Path to kicad-cli for real DRC / SVG export; auto-detected when installed
KICAD_CLI=kicad-cli
# The Docker image ships KiCad 10 (kicad-cli + official symbol/footprint libraries) and a
# pre-built search index, so nothing below is needed there. For a bare-metal install point
# KICAD_APP_PATH at the KiCad share dir (Linux default /usr/share/kicad) — the library tables
# are seeded automatically on startup if the KiCad GUI never ran.
KICAD_VERSION=10.0
KICAD_APP_PATH=

# ================= Docker build mirrors (optional) =================
# Official KiCad runtime image. Pin the patch version for reproducible builds.
KICAD_IMAGE_TAG=10.0.5
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com/
# Debian mirror host used for Python runtime packages (default deb.debian.org)
# APT_MIRROR=mirrors.aliyun.com
